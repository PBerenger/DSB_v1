<Window x:Class="DoubleSceensBlack.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#202938" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64748B" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F3F6FA" />
        <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#CBD5E1" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3978D4" />
        <SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="#3978D4" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3978D4" />
        <SolidColorBrush x:Key="SwitchOffBrush" Color="#CBD5E1" />
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleButtonBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleButtonBorder" Property="Background"
                                        Value="{DynamicResource ButtonBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleButtonBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button"
               BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource FieldBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                        Value="{DynamicResource ButtonHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OptionSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="15"
                                    Background="{DynamicResource SwitchOffBrush}" />
                            <Ellipse x:Name="Thumb" Width="22" Height="22" Margin="4"
                                     Fill="White" HorizontalAlignment="Left" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
    <Grid Background="{DynamicResource WindowBackgroundBrush}" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource WindowBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock Margin="14,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Text="Options" />
                </Border>
                <Button Grid.Column="1" Style="{StaticResource TitleBarCloseButtonStyle}"
                        Content="×" ToolTip="Fermer" AutomationProperties.Name="Fermer"
                        Click="CloseWindow_Click" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Padding="26" Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel>
            <TextBlock Margin="0,5,0,20" FontSize="13"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="Personnalisez l'apparence, le démarrage et le raccourci de l'application." />

            <Border Margin="0,0,0,12" Padding="16" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Thème" />
                        <TextBlock Margin="0,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Choisissez l'apparence de l'interface." />
                    </StackPanel>
                    <ComboBox x:Name="ThemeComboBox" Grid.Column="1" Height="36" Padding="8,5"
                              VerticalContentAlignment="Center"
                              Style="{StaticResource ThemeSelectorStyle}"
                              SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Bleu" />
                        <ComboBoxItem Content="Noir" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Margin="0,0,0,12" Padding="16" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="54" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold"
                                   Text="Ouvrir l'application au démarrage" />
                        <TextBlock Margin="0,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Lancer l'application à votre ouverture de session." />
                    </StackPanel>
                    <TextBlock x:Name="StartupValueText" Grid.Column="1" Margin="0,0,12,0"
                               VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="White">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Non" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=StartupToggle}" Value="True">
                                        <Setter Property="Text" Value="Oui" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ToggleButton x:Name="StartupToggle" Grid.Column="2"
                                  AutomationProperties.Name="Ouvrir l'application au démarrage de Windows"
                                  Style="{StaticResource OptionSwitchStyle}" />
                </Grid>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="54" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold"
                                   Text="Réduire dans la barre des tâches" />
                        <TextBlock Margin="0,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="BSD est réduit dans la zone de notification." />
                    </StackPanel>
                    <TextBlock x:Name="MinimizeValueText" Grid.Column="1" Margin="0,0,12,0"
                               VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="White">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Non" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=MinimizeToggle}" Value="True">
                                        <Setter Property="Text" Value="Oui" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ToggleButton x:Name="MinimizeToggle" Grid.Column="2"
                                  AutomationProperties.Name="Réduire dans la barre des tâches"
                                  Style="{StaticResource OptionSwitchStyle}" />
                </Grid>
            </Border>

            <Border Margin="0,12,0,0" Padding="16" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Raccourci global" />
                    <TextBlock Margin="0,4,0,10" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Text="Cliquez sur « Modifier », puis saisissez une combinaison avec Ctrl, Alt, Maj ou Windows." />
                    <DockPanel LastChildFill="True">
                        <Button x:Name="ResetHotkeyButton" DockPanel.Dock="Right" Margin="10,0,0,0"
                                Content="Par défaut" Click="ResetHotkeyButton_Click" />
                        <Button x:Name="ChangeHotkeyButton" DockPanel.Dock="Right" Margin="10,0,0,0"
                                Content="Modifier" Click="ChangeHotkeyButton_Click" />
                        <TextBox x:Name="HotkeyTextBox" Height="38" Padding="10,8" FontSize="14"
                                 Background="{DynamicResource FieldBackgroundBrush}"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 BorderBrush="{DynamicResource FieldBorderBrush}"
                                 IsReadOnly="True" Focusable="True"
                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" />
                    </DockPanel>
                    <TextBlock x:Name="HotkeyStatusText" Margin="0,8,0,0" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Le raccourci fonctionne tant que l'application est ouverte." />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,22,0,0" HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Margin="0,0,10,0" MinWidth="100" Content="Annuler"
                        IsCancel="True" />
                <Button MinWidth="100" Content="Enregistrer" IsDefault="True"
                        Click="SaveButton_Click" />
            </StackPanel>
        </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
